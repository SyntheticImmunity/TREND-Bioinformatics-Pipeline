# =============================================================================
# Internal-only, UNPUBLISHED lab screens (prostate cancer, melanoma).
# These belong to unpublished lab projects and must never reach the public repo
# or the Docker image (also listed in .dockerignore). The manuscript build ships
# only the ovarian_cancer + T_cell_activation screens. The dashboard registers
# these from the gitignored side file below and degrades cleanly without them.
# =============================================================================
project_data/final_enhancer_activity_results/prostate_cancer/
project_data/final_enhancer_activity_results/melanoma/
dashboard/backend/internal_projects.json
dashboard/backend/schemas/prostate_sensor_activity_concise.yaml
dashboard/backend/schemas/melanoma_sensor_activity_concise.yaml

# =============================================================================
# Manuscript-revision working material: keep NEW files out of the public repo.
#
# Revision work is proprietary while the paper is under review and while the
# figures are not finalized. This covers, among other things, business and
# investor material, IACUC and administrative documents containing staff contact
# details, editor and collaborator meeting notes, reviewer-response drafts, and
# figures built from the unpublished prostate and melanoma screens above.
#
# Note this rule only affects UNTRACKED files. Revision files already committed
# before this line remain tracked and continue to work normally. To publish a
# specific finalized item later, add it deliberately with `git add -f <path>`.
# =============================================================================
revision_analysis/

# TypeScript incremental build cache: a local build artifact, never source.
dashboard/frontend/tsconfig.tsbuildinfo
